# Solo en el backend. Copiar a .env.server para Docker --env-file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&sslrootcert=system
FRONTEND_ORIGINS=https://tu-proyecto.vercel.app
KARAOKE_DATA_DIR=/data
# Necesario en Render Free para conservar audio/video fuera del disco temporal.
# Token privado del store Vercel Blob; nunca usar el prefijo VITE_.
BLOB_READ_WRITE_TOKEN=
